APP_NAME=AI-Chatbot
APP_ENV=development
DEBUG=false

# Used by app/ingestion/embedder.py - local model, no key needed, just the name
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# The app always reads the database connection from these (Streamlit included).
# On Streamlit Cloud, put the same keys in App settings -> Secrets instead.
POSTGRES_HOST=your-neon-host-here
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=your-neon-user
POSTGRES_PASSWORD=your-neon-password
POSTGRES_SSLMODE=require

# Required for chat answers — there is no UI field to paste a key into.
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

VECTOR_TABLE=document_chunks
QUERY_TOP_K=5