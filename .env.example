APP_NAME=AI-Chatbot
APP_ENV=development
DEBUG=false

# Used by app/ingestion/embedder.py - local model, no key needed, just the name
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# Used as fallback defaults only - the Streamlit UI overrides these at runtime.
# Scripts run OUTSIDE the UI (ingest.py, store.py directly) still 
# need these set correctly, since they don't go through the Streamlit connect screen.
POSTGRES_HOST=your-neon-host-here
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=your-neon-user
POSTGRES_PASSWORD=your-neon-password
POSTGRES_SSLMODE=require

# Fallback defaults for scripts run outside the UI - same reasoning as above
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-120b

VECTOR_TABLE=document_chunks
QUERY_TOP_K=5